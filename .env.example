# Copy to .env and fill in. `docker compose up` reads this file's real
# counterpart for both container environment (env_file:) and ${VAR}
# interpolation, so a missing key stops the stack rather than defaulting.

# --- Postgres -----------------------------------------------------------
# POSTGRES_PASSWORD initialises the database container; PG_PASSWORD and
# DESTINATION__POSTGRES__CREDENTIALS__PASSWORD are what clients authenticate
# with. All three must be the SAME value.
# Note: the password is baked into the pg_data volume on first creation.
# Changing it later needs `docker compose down -v` (destroys data) or an
# `ALTER ROLE` inside the running container.
POSTGRES_PASSWORD=change-me

DESTINATION__POSTGRES__CREDENTIALS__HOST=localhost
DESTINATION__POSTGRES__CREDENTIALS__PORT=5455
DESTINATION__POSTGRES__CREDENTIALS__USERNAME=postgres
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=change-me
DESTINATION__POSTGRES__CREDENTIALS__DATABASE=postgres

PG_HOST=localhost
PG_PORT=5455
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=change-me
# dbt puts marts in <schema>_marts, and the portal reads that. `public`
# here resolves every mart query to a non-existent relation, which the
# pages report as "de berekening is nog niet gedraaid" - the misleading
# answer rather than an error.
TARGET_SCHEMA=public_marts

# dbt build parallelism. Default 2 suits a 2 vCPU host; Postgres does the same
# ~21 CPU-seconds of work whatever this is, so more threads than cores only
# queues. Raise to 4 on a machine with 4+ cores.
DBT_THREADS=2

# dbt profile target: "default" locally, matching src/bonuschef/sql/profiles.yml
ENVIRONMENT=default

# --- GitHub product snapshots -------------------------------------------
# Personal access token with read access to the snapshot repository.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-user
GITHUB_REPO=your-snapshot-repo
GITHUB_MESSAGE_FILTER=daily update
GITHUB_START_DATE=2025-01-01T00:00:00Z
GITHUB_BRANCH=main
GITHUB_MAX_PAGES=10
GITHUB_PATH=data/products.json

# --- Albert Heijn store markdowns ("laatste kans koopjes") --------------
# AH_STORE_ID defaults to 1876 (Eindhoven Torenallee). AH_REFRESH_TOKEN comes
# from a one-time `python -m bonuschef.utils.ah_login`; it is refreshed
# automatically at runtime and only needs re-issuing if AH expires it.
AH_STORE_ID=1876
AH_REFRESH_TOKEN=paste-from-ah-login

# --- The test environment (optional) -------------------------------------
# Set this and the Beheer page gains a panel saying whether the test
# environment is running and how old its copy of the data is. Leave it unset
# and the panel is omitted entirely - a deployment with one environment is not
# broken.
#
# Read-only, and one way: production reads the test environment, never the
# other way round.
#
# The catch worth knowing before you set it: this is resolved from inside
# production's container, where 127.0.0.1 is the container's own loopback, not
# the host's. So the test database's published 127.0.0.1:5456 is not reachable
# as written. docs/deployment.md lists the ways to give it a route; none is
# required, and the panel is a convenience rather than part of the delivery
# path.
BONUSCHEF_TEST_DATABASE_URL=

# --- Failure alerts (optional) -------------------------------------------
# Deliberately empty: alerting is opt-in, and a topic copied from a template
# would be a guessable public channel. The topic is a capability URL - anyone
# who knows the name can read your notifications - so generate a long random
# one (e.g. `openssl rand -hex 16`) and subscribe the ntfy app to it.
# Leave unset and nothing is sent; nothing breaks.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
