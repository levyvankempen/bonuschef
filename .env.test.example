# Copy to .env.test and fill in. This is the test environment's configuration,
# and what it leaves out matters more than what it sets.
#
# NO ALBERT HEIJN CREDENTIAL. Not "left blank for now" - there must never be
# one here. There is a single credential, and refreshing it may rotate the
# refresh token; the code persists the rotated one. Two environments refreshing
# it would invalidate each other's, and the symptom is production's prices
# quietly ceasing to update rather than anything failing here. There is also no
# pipeline in this environment to use a credential with.
#
# The data comes from production instead: ./scripts/copy-to-test.sh

# --- Where this environment keeps its database --------------------------
# A directory on the 500 GB SSD. No default on purpose: the only space
# available without this is production's 16 GiB rootfs, and filling that takes
# production down. The disk needs provisioning on the Proxmox host and a
# mountpoint adding to the container first - see docs/deployment.md.
BONUSCHEF_TEST_DATA_DIR=/mnt/bulk/bonuschef-test

# --- Postgres -----------------------------------------------------------
# A DIFFERENT password from production's. Not for secrecy - both databases sit
# on one host behind one boundary - but so that a connection string copied from
# the wrong terminal fails to authenticate instead of succeeding against the
# database you did not mean.
# All three must be the SAME value as each other.
POSTGRES_PASSWORD=change-me-not-productions-password
PG_PASSWORD=change-me-not-productions-password
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=change-me-not-productions-password

PG_HOST=postgres
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
# dbt puts marts in <schema>_marts and the portal reads that. `public` here
# resolves every mart query to a non-existent relation, which the pages report
# as "de berekening is nog niet gedraaid" - the misleading answer rather than
# an error.
TARGET_SCHEMA=public_marts
ENVIRONMENT=default

# --- Ports on the host --------------------------------------------------
# Different from production's 5455 and 8501. Both environments are on this
# host; confusing them is the expensive mistake.
BONUSCHEF_TEST_PG_PORT=5456
BONUSCHEF_TEST_PORTAL_PORT=8502

# --- The sign-in wall ---------------------------------------------------
# The copy carries production's accounts, so sign in with your own. Keep the
# wall up: this environment is not published, but an unauthenticated portal
# holding real accounts is not something to leave lying around either.
BONUSCHEF_REQUIRE_SIGN_IN=1
# An invite code is only needed to create new accounts here, which the copy
# makes unnecessary. Left empty so registration is closed.
BONUSCHEF_INVITE_CODE=

# --- Failure alerts -----------------------------------------------------
# Empty, and must stay empty. The test environment sharing production's ntfy
# topic would put test noise on the operator's phone next to real alerts,
# which is how real alerts come to be ignored.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
